{
  "openapi": "3.0.0",
  "info": { "title": "enumStyle fixture", "version": "1.0.0" },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "tags": ["pets"],
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": { "$ref": "#/components/schemas/PetStatus" }
          },
          {
            "in": "query",
            "name": "fixture",
            "schema": { "$ref": "#/components/schemas/SchBustlingTypeface38" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SchBustlingTypeface38": {
        "type": "string",
        "description": "Fixture field.",
        "enum": ["ev0", "ev1", "ev2", "ev3", "ev4", "ev5", "ev6"]
      },
      "PetStatus": {
        "type": "string",
        "enum": ["available", "pending", "sold"],
        "x-enumNames": ["Available", "Pending", "Sold"]
      },
      "PetKind": {
        "type": "integer",
        "enum": [0, 1, 2],
        "x-enumNames": ["Cat", "Dog", "Bird"]
      },
      "Pet": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "status": { "$ref": "#/components/schemas/PetStatus" },
          "kind": { "$ref": "#/components/schemas/PetKind" }
        }
      }
    }
  }
}
