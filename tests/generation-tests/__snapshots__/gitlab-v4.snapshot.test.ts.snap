    /**
     * ID of a user
     * @format int32
     * @example 1
     */
    user_id?: number;
  }[];
  /** Array of users, groups, deploy keys, or access levels allowed to push to protected branches */
  allowed_to_push?: {
    /** Delete the object when true */
    _destroy?: boolean;
    /**
     * Access level allowed to push
     * @format int32
     */
    access_level?: 30 | 40 | 60 | 0;
    /**
     * Deploy key allowed to push
     * @format int32
     * @example 1
     */
    deploy_key_id?: number;
    /**
     * ID of a group
     * @format int32
     * @example 1
     */
    group_id?: number;
    /**
     * ID of a project
     * @format int32
     * @example 40
     */
    id?: number;
    /**
     * ID of a user
     * @format int32
     * @example 1
     */
    user_id?: number;
  }[];
  /** Array of users, groups, or access levels allowed to unprotect protected branches */
  allowed_to_unprotect?: {
    /** Delete the object when true */
    _destroy?: boolean;
    /**
     * Access level allowed to unprotect
     * @format int32
     */
    access_level?: 30 | 40 | 60;
    /**
     * ID of a group
