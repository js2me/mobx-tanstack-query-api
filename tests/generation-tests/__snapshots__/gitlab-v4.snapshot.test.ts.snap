/**
 * TestReportEntity model
 */
export interface TestReportEntityDC {
  /**
   * @format int32
   * @example 0
   */
  error_count: number;
  /**
   * @format int32
   * @example 0
   */
  failed_count: number;
  /**
   * @format int32
   * @example 0
   */
  skipped_count: number;
  /**
   * @format int32
   * @example 1
   */
  success_count: number;
  test_suites: TestSuiteEntityDC[];
  /**
   * @format int32
   * @example 1
   */
  total_count: number;
  /**
   * @format int32
   * @example 180
   */
  total_time: number;
}

/**
 * TestReportSummaryEntity model
 */
export interface TestReportSummaryEntityDC {
  test_suites: TestSuiteSummaryEntityDC;
  /** @example {"time":0.42,"count":2,"success":2,"failed":0,"skipped":0,"error":0,"suite_error":null} */
  total: Record<string, any>;
}

export interface TestSuiteEntityDC {
  /**
   * @format int32
   * @example 0
   */
  error_count: number;
  /**
   * @format int32
   * @example 0
   */
  failed_count: number;
  /** @example "test" */
  name: string;
  /**
   * @format int32
   * @example 12
   */
  skipped_count: number;
  /**
   * @format int32
   * @example 3351
   */
  success_count: number;
  /** @example "JUnit XML parsing failed: 1:1: FATAL: Document is empty" */
  suite_error?: string;
  test_cases?: TestCaseEntityDC[];
  /**
   * @format int32
   * @example 3363
   */
  total_count: number;
  /**
   * @format int32
   * @example 1904
   */
  total_time: number;
}

export interface TestSuiteSummaryEntityDC {
  /** @example [66004] */
  build_ids: number[];
  /**
   * @format int32
   * @example 0
   */
  error_count: number;
  /**
   * @format int32
   * @example 0
   */
  failed_count: number;
  /** @example "test" */
  name: string;
  /**
   * @format int32
   * @example 12
   */
  skipped_count: number;
  /**
   * @format int32
   * @example 3351
   */
  success_count: number;
  /** @example "JUnit XML parsing failed: 1:1: FATAL: Document is empty" */
  suite_error: string;
  test_cases?: TestCaseEntityDC[];
  /**
   * @format int32
   * @example 3363
   */
  total_count: number;
  /**
   * @format int32
   * @example 1904
   */
  total_time: number;
}


